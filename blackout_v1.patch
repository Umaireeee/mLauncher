--- orig/app/src/test/java/com/github/codeworkscreativehub/mlauncher/helper/BlockedAppsTest.kt	1970-01-01 00:00:00.000000000 +0000
+++ main/app/src/test/java/com/github/codeworkscreativehub/mlauncher/helper/BlockedAppsTest.kt	2026-09-21 12:53:56.900316978 +0000
@@ -0,0 +1,58 @@
+package com.github.codeworkscreativehub.mlauncher.helper
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/**
+ * Pins how Blackout marks a blocked app. The rules are pure, so they run on the JVM in CI before
+ * any emulator does.
+ */
+class BlockedAppsTest {
+
+    private val offWhite = 0xFFF1EFE8.toInt()
+
+    // Paint.STRIKE_THRU_TEXT_FLAG. Written as its value so the test needs no Android classes.
+    private val strike = 16
+    private val antiAlias = 1
+    private val subpixel = 128
+
+    @Test
+    fun aBlockedAppIsFadedToThirtyPercent() {
+        assertEquals(0x4DF1EFE8, BlockedApps.labelColor(offWhite, blocked = true))
+    }
+
+    @Test
+    fun anAvailableAppKeepsItsExactColour() {
+        assertEquals(offWhite, BlockedApps.labelColor(offWhite, blocked = false))
+    }
+
+    @Test
+    fun fadingKeepsTheHueAndOnlyChangesAlpha() {
+        val faded = BlockedApps.labelColor(offWhite, blocked = true)
+        assertEquals(offWhite and 0x00FFFFFF, faded and 0x00FFFFFF)
+    }
+
+    @Test
+    fun strikeThroughIsAddedForABlockedApp() {
+        assertEquals(antiAlias or strike, BlockedApps.paintFlags(antiAlias, blocked = true))
+    }
+
+    /** Rows are recycled: an app that's no longer blocked must lose the line it had before. */
+    @Test
+    fun strikeThroughIsRemovedOnceTheAppIsReleased() {
+        assertEquals(antiAlias, BlockedApps.paintFlags(antiAlias or strike, blocked = false))
+    }
+
+    @Test
+    fun otherPaintFlagsAreNeverTouched() {
+        val flags = antiAlias or subpixel
+        assertEquals(flags or strike, BlockedApps.paintFlags(flags, blocked = true))
+        assertEquals(flags, BlockedApps.paintFlags(flags or strike, blocked = false))
+    }
+
+    @Test
+    fun applyingTwiceChangesNothing() {
+        val once = BlockedApps.paintFlags(antiAlias, blocked = true)
+        assertEquals(once, BlockedApps.paintFlags(once, blocked = true))
+    }
+}
