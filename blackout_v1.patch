+    // ---------------------------------------------------------------------------------------------
+    // Blackout: blocked apps look blocked
+    // ---------------------------------------------------------------------------------------------
+
+    private var suspensionCallback: LauncherApps.Callback? = null
+
+    /**
+     * Styles every home app for whether Android is holding it suspended — struck through and faded,
+     * or hidden when "Hide blocked apps" is on — and updates the "apps resting" line.
+     *
+     * Cheap enough to call freely: the suspended list comes from one call to Android and is cached.
+     */
+    private fun refreshBlocked() {
+        val b = _binding ?: return
+        val ctx = context ?: return
+        val suspended = BlockedApps.suspendedPackages(ctx)
+        val hide = prefs.hideBlockedApps
+        val me = Process.myUserHandle()
+        // pageRanges is lateinit and only set after the first layout pass — reading it earlier
+        // would crash the launcher, so check first.
+        val pageRange = if (::pageRanges.isInitialized) pageRanges.getOrNull(currentPage) else null
+
+        for (i in 0 until b.homeAppsLayout.childCount) {
+            val row = b.homeAppsLayout.getChildAt(i) ?: continue
+            // A row is a bare label, or — with usage stats shown — a layout whose first child is.
+            val label = row as? TextView ?: (row as? ViewGroup)?.getChildAt(0) as? TextView ?: continue
+            val app = prefs.getHomeAppModel(i)
+            // The suspended list is this user's; a work-profile copy of the same app is separate.
+            val blocked = app.user == me && app.activityPackage.isNotBlank() && app.activityPackage in suspended
+
+            label.setTextColor(BlockedApps.labelColor(prefs.appColor, blocked))
+            label.paintFlags = BlockedApps.paintFlags(label.paintFlags, blocked)
+            setLockMark(label, blocked && !hide)
+
+            val onPage = pageRange?.contains(i) ?: true
+            row.isVisible = onPage && !(blocked && hide)
+        }
+
+        val count = suspended.size
+        b.restingApps.isVisible = count > 0
+        if (count > 0) {
+            b.restingApps.text = resources.getQuantityString(R.plurals.blackout_apps_resting, count, count)
+        }
+    }
+
+    /**
+     * Puts a small lock after a blocked app's name. Only in the right-hand slot, and only while
+     * it's free: with an icon pack that slot can hold the app's icon, which is never touched.
+     */
+    private fun setLockMark(label: TextView, show: Boolean) {
+        val d = label.compoundDrawables
+        val ours = label.getTag(R.id.blackout_lock_mark) as? Drawable
+        if (show) {
+            if (d[2] != null && d[2] !== ours) return
+            val lock = ours
+                ?: ContextCompat.getDrawable(label.context, R.drawable.ic_blackout_lock)?.mutate()
+                    ?.also { label.setTag(R.id.blackout_lock_mark, it) }
+                ?: return
+            val size = (label.textSize * 0.55f).toInt()
+            lock.setBounds(0, 0, size, size)
+            lock.setTint(BlockedApps.labelColor(prefs.appColor, true))
+            label.setCompoundDrawables(d[0], d[1], lock, d[3])
+            if (d[0] == null) label.compoundDrawablePadding = (label.textSize * 0.35f).toInt()
+        } else if (ours != null && d[2] === ours) {
+            label.setCompoundDrawables(d[0], d[1], null, d[3])
+        }
+    }
+
+    /**
+     * Android tells launchers the moment an app is suspended or released. Only listened to while
+     * home is showing; the check in onStart covers everything that happened while it wasn't.
+     */
+    private fun registerSuspensionCallback() {
+        if (suspensionCallback != null) return
+        val launcherApps = context?.getSystemService(LauncherApps::class.java) ?: return
+        val callback = object : LauncherApps.Callback() {
+            private fun changed() {
+                BlockedApps.invalidate()
+                refreshBlocked()
+            }
+
+            // Both forms: Android has changed which one it calls, and each version deprecates one
+            // of them. Overriding both means the refresh runs whichever this phone uses.
+            override fun onPackagesSuspended(packageNames: Array<out String>, user: UserHandle) = changed()
+
+            override fun onPackagesSuspended(packageNames: Array<out String>, user: UserHandle, launcherExtras: Bundle?) =
+                changed()
+
+            override fun onPackagesUnsuspended(packageNames: Array<out String>, user: UserHandle) = changed()
+
+            // Required by the API. Installs and removals are already handled elsewhere.
+            override fun onPackageRemoved(packageName: String, user: UserHandle) {}
+            override fun onPackageAdded(packageName: String, user: UserHandle) {}
+            override fun onPackageChanged(packageName: String, user: UserHandle) {}
+            override fun onPackagesAvailable(packageNames: Array<out String>, user: UserHandle, replacing: Boolean) {}
+            override fun onPackagesUnavailable(packageNames: Array<out String>, user: UserHandle, replacing: Boolean) {}
+        }
+        try {
+            launcherApps.registerCallback(callback, Handler(Looper.getMainLooper()))
+            suspensionCallback = callback
+        } catch (_: Exception) {
+            // Without live updates the onStart check still catches every change on return home.
+        }
+    }
+
+    private fun unregisterSuspensionCallback() {
+        val callback = suspensionCallback ?: return
+        suspensionCallback = null
+        try {
+            context?.getSystemService(LauncherApps::class.java)?.unregisterCallback(callback)
+        } catch (_: Exception) {
+        }
+    }
