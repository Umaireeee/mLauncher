+package com.github.codeworkscreativehub.mlauncher.helper
+
+import android.content.Context
+import android.content.pm.ApplicationInfo
+import android.content.pm.LauncherApps
+import android.graphics.Paint
+import android.os.Process
+import android.os.SystemClock
+import androidx.core.graphics.ColorUtils
+
+/**
+ * Blackout: knows which apps Android is holding suspended right now, so the launcher can show it.
+ *
+ * Suspension is the state Déchaîner's schedules, time windows and limits put apps in. This reads
+ * Android's own suspended flag rather than talking to Déchaîner, so the two apps need no link at
+ * all — and it works with anything else that suspends apps, such as Digital Wellbeing's focus mode.
+ */
+object BlockedApps {
+
+    /** Drawer rows rebind on every scroll, so the answer is cached briefly instead of re-asked. */
+    private const val CACHE_MS = 2_000L
+
+    /** How faint a blocked app's label is: 30% of its normal colour. */
+    internal const val BLOCKED_ALPHA = 0x4D
+
+    @Volatile
+    private var cachedAt = 0L
+
+    @Volatile
+    private var cached: Set<String> = emptySet()
+
+    /** Packages suspended right now for this user. One call to Android, however many apps. */
+    fun suspendedPackages(context: Context): Set<String> {
+        val now = SystemClock.elapsedRealtime()
+        if (cachedAt != 0L && now - cachedAt < CACHE_MS) return cached
+        cached = try {
+            context.getSystemService(LauncherApps::class.java)
+                .getActivityList(null, Process.myUserHandle())
+                .filter { (it.applicationInfo.flags and ApplicationInfo.FLAG_SUSPENDED) != 0 }
+                .map { it.applicationInfo.packageName }
+                .toSet()
+        } catch (_: Exception) {
+            emptySet()
+        }
+        cachedAt = now
+        return cached
+    }
+
+    /** Forget the cached answer — called the moment Android reports a suspension change. */
+    fun invalidate() {
+        cachedAt = 0L
+    }
+
+    fun isSuspended(context: Context, packageName: String): Boolean =
+        packageName.isNotBlank() && packageName in suspendedPackages(context)
+
+    /** A blocked app's label colour: the normal colour, faded. Pure, so it's unit-tested. */
+    fun labelColor(normal: Int, blocked: Boolean): Int =
+        if (blocked) ColorUtils.setAlphaComponent(normal, BLOCKED_ALPHA) else normal
+
+    /** Adds or removes the strike-through, leaving every other paint flag untouched. */
+    fun paintFlags(current: Int, blocked: Boolean): Int =
+        if (blocked) current or Paint.STRIKE_THRU_TEXT_FLAG
+        else current and Paint.STRIKE_THRU_TEXT_FLAG.inv()
+}
