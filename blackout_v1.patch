--- orig/app/src/main/java/com/github/codeworkscreativehub/mlauncher/helper/BlackoutPreset.kt	1970-01-01 00:00:00.000000000 +0000
+++ main/app/src/main/java/com/github/codeworkscreativehub/mlauncher/helper/BlackoutPreset.kt	2026-09-21 12:51:02.421814320 +0000
@@ -0,0 +1,58 @@
+package com.github.codeworkscreativehub.mlauncher.helper
+
+import com.github.codeworkscreativehub.mlauncher.data.Constants
+import com.github.codeworkscreativehub.mlauncher.data.Prefs
+
+/**
+ * The Blackout look in one tap: true black, one warm off-white, one amber accent, Montserrat.
+ *
+ * True black matters on an AMOLED screen, where black pixels are switched off: it looks deeper
+ * and costs almost no battery. Amber is the only colour anywhere — it's used for the lock on the
+ * "apps resting" line — so the eye goes straight to it, and only when something is blocked.
+ *
+ * Deliberately leaves the person's own choices alone: which apps are on the home screen, how many,
+ * gestures, and anything else that isn't purely how it looks.
+ */
+object BlackoutPreset {
+
+    private const val BLACK = 0xFF000000.toInt()
+    private const val OFF_WHITE = 0xFFF1EFE8.toInt()
+    private const val GREY = 0xFF888780.toInt()
+    private const val DARK_GREY = 0xFF5F5E5A.toInt()
+    private const val AMBER = 0xFFEF9F27.toInt()
+
+    fun apply(prefs: Prefs) {
+        prefs.appTheme = Constants.Theme.Dark
+
+        prefs.backgroundColor = BLACK
+        // This setting runs backwards: 0 means fully opaque, 100 fully transparent.
+        prefs.opacityNum = 0
+
+        prefs.appColor = OFF_WHITE
+        prefs.clockColor = OFF_WHITE
+        prefs.dateColor = GREY
+        prefs.dailyWordColor = GREY
+        prefs.batteryColor = DARK_GREY
+        prefs.alarmClockColor = AMBER
+
+        // Montserrat keeps its digits on the line, which a clock this size needs. (Raleway looks
+        // elegant but uses old-style numerals that dip below it.)
+        prefs.fontFamily = Constants.FontFamily.Montserrat
+
+        prefs.clockSize = 68
+        prefs.dateSize = 14
+        prefs.appSize = 26
+        prefs.batterySize = 12
+        prefs.textPaddingSize = 9
+
+        prefs.homeAlignment = Constants.Gravity.Left
+        prefs.clockAlignment = Constants.Gravity.Left
+        prefs.dateAlignment = Constants.Gravity.Left
+
+        // Text only on the home screen. Icons in the drawer are left as they were.
+        prefs.iconPackHome = Constants.IconPacks.Disabled
+
+        prefs.showDailyWord = false
+        prefs.showWeather = false
+    }
+}
