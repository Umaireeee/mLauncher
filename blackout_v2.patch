@@ -0,0 +1,73 @@
+package com.github.codeworkscreativehub.mlauncher.helper
+
+import java.time.LocalDate
+import java.time.format.DateTimeParseException
+import java.time.temporal.ChronoUnit
+
+/**
+ * Blackout: the pure rules behind the home screen, kept free of Android so they run as plain
+ * JVM unit tests in CI before any emulator does.
+ */
+object BlackoutLogic {
+
+    /** How faint a resting app's name is: 30% of its normal colour. */
+    const val RESTING_ALPHA = 0x4D
+
+    /** A resting app's name colour: the same hue, faded. */
+    fun restingColor(normal: Int, resting: Boolean): Int =
+        if (resting) (normal and 0x00FFFFFF) or (RESTING_ALPHA shl 24) else normal
+
+    /**
+     * Apps a blocker has hidden (Déchaîner's schedule mode uses DevicePolicyManager hiding).
+     *
+     * Android treats a hidden app as uninstalled for normal queries, but still reports it when
+     * asked to include uninstalled packages. So: installed-including-hidden minus visible.
+     * Only apps this launcher has seen as launchable before count ([known]); that keeps out the
+     * system packages some phones ship hidden, which were never real apps to the person.
+     */
+    fun hiddenApps(
+        installedIncludingHidden: Set<String>,
+        visible: Set<String>,
+        known: Set<String>,
+        self: String
+    ): Set<String> =
+        installedIncludingHidden.asSequence()
+            .filter { it !in visible && it in known && it != self }
+            .toSet()
+
+    /** Days from [today] to the countdown date, or null when there is no countdown to show. */
+    fun countdownDays(today: LocalDate, iso: String): Long? {
+        if (iso.isBlank()) return null
+        val target = try {
+            LocalDate.parse(iso.trim())
+        } catch (_: DateTimeParseException) {
+            return null
+        }
+        val days = ChronoUnit.DAYS.between(today, target)
+        return if (days < 0) null else days
+    }
+
+    /** "1h 12m", "45m", "2h". Null under a minute, so a fresh morning shows nothing. */
+    fun screenTime(millis: Long): String? {
+        val minutes = millis / 60_000L
+        if (minutes < 1) return null
+        val h = minutes / 60
+        val m = minutes % 60
+        return when {
+            h == 0L -> "${m}m"
+            m == 0L -> "${h}h"
+            else -> "${h}h ${m}m"
+        }
+    }
+
+    /**
+     * Taps on resting apps held back today. [storedDay] is the epoch day the stored count
+     * belongs to; a new day starts again from zero. Returns the count after this tap.
+     */
+    fun nextHeldBack(storedDay: Long, storedCount: Int, today: Long): Int =
+        if (storedDay == today) storedCount + 1 else 1
+
+    /** The count to show for today without adding a tap. */
+    fun heldBackToday(storedDay: Long, storedCount: Int, today: Long): Int =
+        if (storedDay == today) storedCount else 0
+}
