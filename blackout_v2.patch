@@ -0,0 +1,82 @@
+package com.github.codeworkscreativehub.mlauncher.helper
+
+import android.content.Context
+import android.graphics.Typeface
+import java.io.File
+
+/**
+ * Blackout's typefaces: Instrument Serif (display) and Geist (small print).
+ *
+ * The font files are fetched by the build workflow into assets/blackout/, because a text patch
+ * can't carry them. Every getter falls back to a system face, so a build without them still
+ * runs — it just looks plainer.
+ */
+object BlackoutFonts {
+
+    private const val SERIF = "blackout/InstrumentSerif-Regular.ttf"
+    private const val SERIF_ITALIC = "blackout/InstrumentSerif-Italic.ttf"
+    private const val SANS = "blackout/Geist.ttf"
+
+    @Volatile
+    private var serif: Typeface? = null
+
+    @Volatile
+    private var serifItalic: Typeface? = null
+    private val sans = HashMap<Int, Typeface>()
+
+    fun serif(context: Context): Typeface =
+        serif ?: (fromAsset(context, SERIF) ?: Typeface.SERIF).also { serif = it }
+
+    fun serifItalic(context: Context): Typeface =
+        serifItalic ?: (fromAsset(context, SERIF_ITALIC) ?: Typeface.create(Typeface.SERIF, Typeface.ITALIC))
+            .also { serifItalic = it }
+
+    /** Geist at a weight (400 regular, 500 medium). */
+    fun sans(context: Context, weight: Int = 400): Typeface = synchronized(sans) {
+        sans[weight] ?: run {
+            val built: Typeface? = try {
+                if (hasAsset(context, SANS)) {
+                    Typeface.Builder(context.assets, SANS)
+                        .setFontVariationSettings("'wght' $weight")
+                        .build()
+                } else null
+            } catch (_: Exception) {
+                null
+            }
+            val tf = built ?: Typeface.create(Typeface.SANS_SERIF, weight, false)
+            sans[weight] = tf
+            tf
+        }
+    }
+
+    /**
+     * Makes Instrument Serif the launcher-wide font, through mLauncher's own "Custom font" slot,
+     * so the drawer and every other screen match. False if the font isn't in this build.
+     */
+    fun installAsLauncherFont(context: Context): Boolean {
+        if (!hasAsset(context, SERIF)) return false
+        return try {
+            val target = File(context.filesDir, "CustomFont.ttf")
+            context.assets.open(SERIF).use { input ->
+                target.outputStream().use { output -> input.copyTo(output) }
+            }
+            target.length() > 0
+        } catch (_: Exception) {
+            false
+        }
+    }
+
+    private fun hasAsset(context: Context, path: String): Boolean = try {
+        context.assets.open(path).use { true }
+    } catch (_: Exception) {
+        false
+    }
+
+    private fun fromAsset(context: Context, path: String): Typeface? =
+        if (!hasAsset(context, path)) null
+        else try {
+            Typeface.createFromAsset(context.assets, path)
+        } catch (_: Exception) {
+            null
+        }
+}
