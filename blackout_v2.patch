+package com.github.codeworkscreativehub.mlauncher.helper
+
+import android.app.AlertDialog
+import android.app.DatePickerDialog
+import android.content.Context
+import android.text.InputType
+import android.widget.EditText
+import android.widget.FrameLayout
+import com.github.codeworkscreativehub.mlauncher.R
+import com.github.codeworkscreativehub.mlauncher.data.Prefs
+import java.time.LocalDate
+import java.time.format.DateTimeFormatter
+
+/**
+ * Blackout: sets the home screen countdown — what it's to, then the date. Used from Settings and
+ * by tapping the countdown line on home.
+ */
+object CountdownEditor {
+
+    fun show(context: Context, prefs: Prefs, onChanged: () -> Unit) {
+        val density = context.resources.displayMetrics.density
+        val input = EditText(context).apply {
+            setText(prefs.countdownLabel)
+            hint = context.getString(R.string.blackout_countdown_hint)
+            setSingleLine(true)
+            inputType = InputType.TYPE_CLASS_TEXT
+            setSelection(text.length)
+        }
+        val frame = FrameLayout(context).apply {
+            val pad = (22 * density).toInt()
+            setPadding(pad, (8 * density).toInt(), pad, 0)
+            addView(input)
+        }
+
+        AlertDialog.Builder(context)
+            .setTitle(R.string.blackout_countdown_title)
+            .setView(frame)
+            .setPositiveButton(R.string.blackout_countdown_pick_date) { _, _ ->
+                val label = input.text.toString().trim()
+                    .ifEmpty { context.getString(R.string.blackout_countdown_default) }
+                val start = parse(prefs.countdownDate) ?: LocalDate.now().plusDays(30)
+                val picker = DatePickerDialog(
+                    context,
+                    { _, year, month, day ->
+                        prefs.countdownLabel = label
+                        prefs.countdownDate = LocalDate.of(year, month + 1, day).toString()
+                        onChanged()
+                    },
+                    start.year, start.monthValue - 1, start.dayOfMonth
+                )
+                picker.datePicker.minDate = System.currentTimeMillis() - 1_000L
+                picker.show()
+            }
+            .setNeutralButton(R.string.blackout_countdown_turn_off) { _, _ ->
+                prefs.countdownDate = ""
+                prefs.countdownLabel = ""
+                onChanged()
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    /** "the Feb attempt · 1 Feb 2027", or "Off". */
+    fun summary(context: Context, prefs: Prefs): String {
+        val date = parse(prefs.countdownDate)
+        val label = prefs.countdownLabel.trim()
+        if (date == null || label.isEmpty()) return context.getString(R.string.blackout_countdown_off)
+        return "$label · ${date.format(DateTimeFormatter.ofPattern("d MMM yyyy", prefs.appLanguage.locale()))}"
+    }
+
+    private fun parse(iso: String): LocalDate? =
+        if (iso.isBlank()) null else try {
+            LocalDate.parse(iso.trim())
+        } catch (_: Exception) {
+            null
+        }
+}
diff -ruN -x .github -x README.md -x '*.patch' orig/app/src/main/java/com/github/codeworkscreativehub/mlauncher/helper/RestingApps.kt main/app/src/main/java/com/github/codeworkscreativehub/mlauncher/helper/RestingApps.kt
--- orig/app/src/main/java/com/github/codeworkscreativehub/mlauncher/helper/RestingApps.kt	1970-01-01 00:00:00.000000000 +0000
+++ main/app/src/main/java/com/github/codeworkscreativehub/mlauncher/helper/RestingApps.kt	2026-09-22 21:08:16.195075846 +0000
@@ -0,0 +1,122 @@
+package com.github.codeworkscreativehub.mlauncher.helper
+
+import android.content.Context
+import android.content.pm.ApplicationInfo
+import android.content.pm.LauncherApps
+import android.content.pm.PackageManager
+import android.os.Process
+import android.os.SystemClock
+import androidx.core.content.edit
+
+/**
+ * Blackout: which apps are "resting" right now — taken away by a blocker such as Déchaîner.
+ *
+ * Two ways an app can be taken away, and both count:
+ * - Suspended (Déchaîner's limits and cooldowns, Digital Wellbeing): still listed, flagged.
+ * - Hidden (Déchaîner's schedule mode): gone from every normal query, as if uninstalled.
+ *
+ * Reads Android's own state rather than talking to Déchaîner, so the two apps need no link.
+ */
+object RestingApps {
+
+    data class Snapshot(val suspended: Set<String>, val hidden: Set<String>) {
+        val all: Set<String> get() = suspended + hidden
+        val count: Int get() = all.size
+        fun isResting(packageName: String): Boolean =
+            packageName.isNotBlank() && (packageName in suspended || packageName in hidden)
+
+        companion object {
+            val EMPTY = Snapshot(emptySet(), emptySet())
+        }
+    }
+
+    /** Rows rebind on every scroll and home refreshes often, so the answer is cached briefly. */
+    private const val CACHE_MS = 2_000L
+
+    private const val FILE = "blackout.state"
+    private const val KEY_KNOWN = "known_launchable"
+    private const val KEY_HELD_DAY = "held_back_day"
+    private const val KEY_HELD_COUNT = "held_back_count"
+
+    @Volatile
+    private var cachedAt = 0L
+
+    @Volatile
+    private var cached: Snapshot? = null
+
+    /** The last answer without asking Android again. Computes once if there is none yet. */
+    fun latest(context: Context): Snapshot = cached ?: snapshot(context)
+
+    /** Fresh-enough answer. Does package queries on a cache miss: prefer calling off the main thread. */
+    fun snapshot(context: Context): Snapshot {
+        val now = SystemClock.elapsedRealtime()
+        val c = cached
+        if (c != null && now - cachedAt < CACHE_MS) return c
+        val fresh = try {
+            read(context.applicationContext)
+        } catch (_: Exception) {
+            c ?: Snapshot.EMPTY
+        }
+        cached = fresh
+        cachedAt = now
+        return fresh
+    }
+
+    /** Forget the cached answer — called the moment Android reports a package change. */
+    fun invalidate() {
+        cachedAt = 0L
+    }
+
+    private fun read(ctx: Context): Snapshot {
+        val launcherApps = ctx.getSystemService(LauncherApps::class.java)
+        val activities = launcherApps.getActivityList(null, Process.myUserHandle())
+
+        val launchable = HashSet<String>()
+        val suspended = HashSet<String>()
+        for (a in activities) {
+            val info = a.applicationInfo
+            launchable += info.packageName
+            if ((info.flags and ApplicationInfo.FLAG_SUSPENDED) != 0) suspended += info.packageName
+        }
+
+        val known = rememberLaunchable(ctx, launchable)
+
+        val pm = ctx.packageManager
+        val base = PackageManager.MATCH_DISABLED_COMPONENTS or
+            PackageManager.MATCH_DISABLED_UNTIL_USED_COMPONENTS
+        val visible = pm.getInstalledApplications(base).mapTo(HashSet()) { it.packageName }
+        val installedIncludingHidden = pm.getInstalledApplications(base or PackageManager.MATCH_UNINSTALLED_PACKAGES)
+            .asSequence()
+            // Still installed for this user. Apps removed with their data kept lack this flag.
+            .filter { (it.flags and ApplicationInfo.FLAG_INSTALLED) != 0 }
+            .mapTo(HashSet()) { it.packageName }
+
+        val hidden = BlackoutLogic.hiddenApps(installedIncludingHidden, visible, known, ctx.packageName)
+        return Snapshot(suspended, hidden)
+    }
+
+    /** Adds today's launchable apps to the remembered set and returns the whole set. */
+    private fun rememberLaunchable(ctx: Context, launchable: Set<String>): Set<String> {
+        val prefs = ctx.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+        val known = prefs.getStringSet(KEY_KNOWN, emptySet())?.toHashSet() ?: HashSet()
+        if (!known.containsAll(launchable)) {
+            known += launchable
+            prefs.edit { putStringSet(KEY_KNOWN, HashSet(known)) }
+        }
+        return known
+    }
+
+    /** Counts one tap on a resting app and returns today's total. */
+    fun recordHeldBack(context: Context): Int {
+        val prefs = context.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+        val today = java.time.LocalDate.now().toEpochDay()
+        val next = BlackoutLogic.nextHeldBack(
+            prefs.getLong(KEY_HELD_DAY, -1L), prefs.getInt(KEY_HELD_COUNT, 0), today
+        )
+        prefs.edit {
+            putLong(KEY_HELD_DAY, today)
+            putInt(KEY_HELD_COUNT, next)
+        }
+        return next
+    }
+}
