diff -ruN -x .github -x README.md -x '*.patch' orig/app/src/test/java/com/github/codeworkscreativehub/mlauncher/helper/BlackoutLogicTest.kt main/app/src/test/java/com/github/codeworkscreativehub/mlauncher/helper/BlackoutLogicTest.kt
--- orig/app/src/test/java/com/github/codeworkscreativehub/mlauncher/helper/BlackoutLogicTest.kt	1970-01-01 00:00:00.000000000 +0000
+++ main/app/src/test/java/com/github/codeworkscreativehub/mlauncher/helper/BlackoutLogicTest.kt	2026-09-22 21:16:38.628081695 +0000
@@ -0,0 +1,154 @@
+package com.github.codeworkscreativehub.mlauncher.helper
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.LocalDate
+
+/**
+ * Pins Blackout's rules. They're pure, so they run on the JVM in CI before any emulator does.
+ */
+class BlackoutLogicTest {
+
+    private val ivory = 0xFFEDE8DF.toInt()
+    private val today = LocalDate.of(2026, 9, 23)
+
+    // --- resting colour ---
+
+    @Test
+    fun aRestingAppIsFadedToThirtyPercent() {
+        assertEquals(0x4DEDE8DF, BlackoutLogic.restingColor(ivory, resting = true))
+    }
+
+    @Test
+    fun anAvailableAppKeepsItsExactColour() {
+        assertEquals(ivory, BlackoutLogic.restingColor(ivory, resting = false))
+    }
+
+    @Test
+    fun fadingKeepsTheHue() {
+        val faded = BlackoutLogic.restingColor(ivory, resting = true)
+        assertEquals(ivory and 0x00FFFFFF, faded and 0x00FFFFFF)
+    }
+
+    // --- hidden apps (Déchaîner's schedule mode) ---
+
+    @Test
+    fun anAppHiddenByTheBlockerCounts() {
+        val hidden = BlackoutLogic.hiddenApps(
+            installedIncludingHidden = setOf("com.instagram.android", "com.whatsapp"),
+            visible = setOf("com.whatsapp"),
+            known = setOf("com.instagram.android", "com.whatsapp"),
+            self = "app.mlauncher.blackout"
+        )
+        assertEquals(setOf("com.instagram.android"), hidden)
+    }
+
+    /** Some phones ship system packages hidden. They were never apps to the person: ignore them. */
+    @Test
+    fun aPackageNeverSeenAsAnAppDoesNotCount() {
+        val hidden = BlackoutLogic.hiddenApps(
+            installedIncludingHidden = setOf("com.vendor.hiddenthing"),
+            visible = emptySet(),
+            known = setOf("com.whatsapp"),
+            self = "app.mlauncher.blackout"
+        )
+        assertTrue(hidden.isEmpty())
+    }
+
+    @Test
+    fun visibleAppsAreNeverHidden() {
+        val hidden = BlackoutLogic.hiddenApps(
+            installedIncludingHidden = setOf("com.whatsapp"),
+            visible = setOf("com.whatsapp"),
+            known = setOf("com.whatsapp"),
+            self = "app.mlauncher.blackout"
+        )
+        assertTrue(hidden.isEmpty())
+    }
+
+    @Test
+    fun theLauncherNeverCountsItself() {
+        val hidden = BlackoutLogic.hiddenApps(
+            installedIncludingHidden = setOf("app.mlauncher.blackout"),
+            visible = emptySet(),
+            known = setOf("app.mlauncher.blackout"),
+            self = "app.mlauncher.blackout"
+        )
+        assertTrue(hidden.isEmpty())
+    }
+
+    // --- the snapshot both kinds of resting go into ---
+
+    @Test
+    fun suspendedAndHiddenAppsAreBothResting() {
+        val s = RestingApps.Snapshot(suspended = setOf("a"), hidden = setOf("b"))
+        assertTrue(s.isResting("a"))
+        assertTrue(s.isResting("b"))
+        assertFalse(s.isResting("c"))
+        assertFalse(s.isResting(""))
+        assertEquals(2, s.count)
+    }
+
+    @Test
+    fun anAppBothSuspendedAndHiddenCountsOnce() {
+        assertEquals(1, RestingApps.Snapshot(setOf("a"), setOf("a")).count)
+    }
+
+    // --- countdown ---
+
+    @Test
+    fun countdownCountsWholeDays() {
+        assertEquals(131L, BlackoutLogic.countdownDays(today, "2027-02-01"))
+    }
+
+    @Test
+    fun countdownOnTheDayIsZero() {
+        assertEquals(0L, BlackoutLogic.countdownDays(today, "2026-09-23"))
+    }
+
+    @Test
+    fun aPassedCountdownDisappears() {
+        assertNull(BlackoutLogic.countdownDays(today, "2026-09-22"))
+    }
+
+    @Test
+    fun noOrBrokenDateMeansNoCountdown() {
+        assertNull(BlackoutLogic.countdownDays(today, ""))
+        assertNull(BlackoutLogic.countdownDays(today, "next feb"))
+    }
+
+    // --- screen time ---
+
+    @Test
+    fun screenTimeReadsNaturally() {
+        assertEquals("1h 12m", BlackoutLogic.screenTime(72 * 60_000L))
+        assertEquals("45m", BlackoutLogic.screenTime(45 * 60_000L))
+        assertEquals("2h", BlackoutLogic.screenTime(120 * 60_000L))
+    }
+
+    @Test
+    fun underAMinuteShowsNothing() {
+        assertNull(BlackoutLogic.screenTime(59_000L))
+    }
+
+    // --- taps held back ---
+
+    @Test
+    fun tapsAddUpWithinADay() {
+        assertEquals(4, BlackoutLogic.nextHeldBack(storedDay = 100, storedCount = 3, today = 100))
+    }
+
+    @Test
+    fun aNewDayStartsFromOne() {
+        assertEquals(1, BlackoutLogic.nextHeldBack(storedDay = 99, storedCount = 30, today = 100))
+    }
+
+    @Test
+    fun yesterdaysTapsDontShowToday() {
+        assertEquals(0, BlackoutLogic.heldBackToday(storedDay = 99, storedCount = 30, today = 100))
+        assertEquals(30, BlackoutLogic.heldBackToday(storedDay = 100, storedCount = 30, today = 100))
+    }
+}
