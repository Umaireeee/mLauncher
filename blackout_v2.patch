+        val accent = prefs.alarmClockColor
+        val ink = prefs.appColor
+        val grey = prefs.dateColor
+
+        b.sheetLock.imageTintList = ColorStateList.valueOf(accent)
+        b.sheetKicker.typeface = sansMedium
+        b.sheetKicker.setTextColor(accent)
+
+        val name = prefs.getAppAlias(app.activityPackage).takeIf { it.isNotBlank() } ?: app.activityLabel
+        val lead = res.getString(R.string.blackout_sheet_title_lead, name)
+        val tail = res.getString(R.string.blackout_sheet_title_tail)
+        b.sheetTitle.typeface = serif
+        b.sheetTitle.setTextColor(ink)
+        b.sheetTitle.text = SpannableStringBuilder(lead).append(' ').apply {
+            val start = length
+            append(tail)
+            setSpan(TypefaceSpan(serifItalic), start, length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            setSpan(ForegroundColorSpan(grey), start, length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+        }
+
+        b.sheetBody.typeface = sans
+        // On the Blackout palette the body sits a step lighter than captions, for easy reading.
+        b.sheetBody.setTextColor(if (grey == BlackoutPreset.GREY) BODY else grey)
+
+        b.sheetHeldNum.typeface = serif
+        b.sheetHeldNum.setTextColor(ink)
+        b.sheetHeldNum.text = held.toString()
+        b.sheetHeldLabel.typeface = sans
+        b.sheetHeldLabel.setTextColor(grey)
+        b.sheetHeldLabel.text = res.getQuantityString(R.plurals.blackout_held_label, held)
+
+        val days = BlackoutLogic.countdownDays(LocalDate.now(), prefs.countdownDate)
+        val label = prefs.countdownLabel.trim()
+        b.sheetCountdownCol.isVisible = days != null && label.isNotEmpty()
+        if (days != null && label.isNotEmpty()) {
+            b.sheetDaysNum.typeface = serif
+            b.sheetDaysNum.setTextColor(ink)
+            b.sheetDaysNum.text = days.toString()
+            b.sheetDaysLabel.typeface = sans
+            b.sheetDaysLabel.setTextColor(grey)
+            b.sheetDaysLabel.text = res.getQuantityString(R.plurals.blackout_days_label, days.toInt(), label)
+        }
+
+        b.sheetBack.typeface = sansMedium
+
+        val dialog = Dialog(activity, R.style.BlackoutSheet)
+        dialog.setContentView(b.root)
+        dialog.setCanceledOnTouchOutside(true)
+        b.sheetBack.setOnClickListener { dialog.dismiss() }
+        dialog.setOnDismissListener { if (showing?.get() === dialog) showing = null }
+        dialog.window?.apply {
+            setGravity(Gravity.BOTTOM)
+            setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            decorView.setPadding(0, 0, 0, 0)
+        }
+        showing = WeakReference(dialog)
+        dialog.show()
+    }
+}
