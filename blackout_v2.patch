+package com.github.codeworkscreativehub.mlauncher.helper
+
+import android.content.Context
+import com.github.codeworkscreativehub.mlauncher.data.Constants
+import com.github.codeworkscreativehub.mlauncher.data.Prefs
+
+/**
+ * The Blackout look in one tap: the editorial home screen.
+ *
+ * True black (pixels off on AMOLED), warm ivory type, one amber accent that only appears when
+ * something is resting, Instrument Serif throughout. Leaves the person's own choices alone:
+ * which apps are on home, how many, gestures, and anything that isn't how it looks.
+ */
+object BlackoutPreset {
+
+    const val BLACK = 0xFF000000.toInt()
+    const val IVORY = 0xFFEDE8DF.toInt()
+    const val GREY = 0xFF8A857C.toInt()
+    const val DIM = 0xFF6E6A62.toInt()
+    const val AMBER = 0xFFE8A13A.toInt()
+
+    /** Softer than ivory, for the countdown line on the Blackout palette. */
+    const val SOFT = 0xFFC9C3B8.toInt()
+
+    fun apply(context: Context, prefs: Prefs) {
+        prefs.appTheme = Constants.Theme.Dark
+
+        prefs.backgroundColor = BLACK
+        // This setting runs backwards: 0 means fully opaque, 100 fully transparent.
+        prefs.opacityNum = 0
+
+        prefs.appColor = IVORY
+        prefs.clockColor = IVORY
+        prefs.dateColor = GREY
+        prefs.dailyWordColor = GREY
+        prefs.batteryColor = DIM
+        // The accent: the lock, the "resting" tags, the countdown's emphasis.
+        prefs.alarmClockColor = AMBER
+
+        // Instrument Serif everywhere, via mLauncher's custom-font slot. If this build is missing
+        // the font file, Merriweather (bundled with mLauncher) is the closest serif.
+        prefs.fontFamily = if (BlackoutFonts.installAsLauncherFont(context)) {
+            Constants.FontFamily.Custom
+        } else {
+            Constants.FontFamily.Merriweather
+        }
+
+        prefs.clockSize = 118
+        prefs.appSize = 36
+        prefs.dateSize = 14
+        prefs.batterySize = 12
+        prefs.textPaddingSize = 10
+
+        prefs.homeAlignment = Constants.Gravity.Left
+        prefs.homeAlignmentBottom = true
+        prefs.clockAlignment = Constants.Gravity.Left
+        prefs.dateAlignment = Constants.Gravity.Left
+
+        // Words, not icons, on home. Screen time moves into the status line.
+        prefs.iconPackHome = Constants.IconPacks.Disabled
+        prefs.appUsageStats = false
+        prefs.showDailyWord = false
+        prefs.showWeather = false
+
+        prefs.blackoutHome = true
+    }
+}
